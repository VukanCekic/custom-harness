# Remote backend (default): OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
# MODEL=deepseek/deepseek-v4.1-flash

# Local backend: any OpenAI-compatible server (LM Studio, llama-server, Ollama).
