{
  "name": "custom-harness",
  "version": "1.0.0",
  "description": "A TypeScript coding agent harness on OpenRouter: streaming tool loop, fail-safe context management, gated subagents and a plan/work/review pipeline.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@openrouter/sdk": "^1.4.10",
    "browserclaw": "^0.20.1",
    "dotenv": "^18.0.4",
    "picocolors": "^1.1.1",
    "playwright": "^1.63.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "oxlint": "^1.86.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.3"
  }
}
